# ===== Base de datos (Railway la provee con plugin PostgreSQL) =====
DATABASE_URL="postgresql://user:pass@host:5432/dbname"

# ===== Autenticación =====
NEXTAUTH_SECRET="cambia-este-valor-por-un-secreto-largo"
NEXTAUTH_URL="http://localhost:3000"

# ===== IA (DeepSeek) =====
DEEPSEEK_API_KEY="sk-..."
DEEPSEEK_MODEL="deepseek-chat"

# ===== Cuenta admin (se crea al ejecutar el seed) =====
ADMIN_EMAIL="admin@ti.local"
ADMIN_PASSWORD="admin1234"
ADMIN_NAME="Administrador TI"

# ===== Notificaciones Telegram =====
# Token del bot que creaste con @BotFather en Telegram
TELEGRAM_BOT_TOKEN=""
# Chat ID donde quieres recibir los avisos (puedes obtenerlo con @userinfobot)
TELEGRAM_CHAT_ID=""

# ===== Notificaciones por correo =====
NOTIFY_EMAIL_TO="ti@empresa.com"
SMTP_HOST="smtp.empresa.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="asistente-ti@empresa.com"

# ===== Notificaciones por correo (Resend) =====
# Si RESEND_API_KEY y RESEND_FROM están configurados, se usa Resend
# en lugar del SMTP anterior.
RESEND_API_KEY="re_..."
# Dominio verificado en Resend (no acepta @gmail.com como remitente)
RESEND_FROM="notificaciones@tu-dominio.com"
