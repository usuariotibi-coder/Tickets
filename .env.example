# ===== Base de datos (PostgreSQL) =====
# En Railway usa la variable interna: postgres.railway.internal (solo dentro de Railway)
DATABASE_URL="postgresql://user:pass@host:5432/dbname"

# ===== Autenticación =====
NEXTAUTH_SECRET="cambia-este-valor-por-un-secreto-largo"
NEXTAUTH_URL="https://tu-app.up.railway.app"

# ===== IA (DeepSeek) =====
DEEPSEEK_API_KEY="sk-..."
DEEPSEEK_MODEL="deepseek-chat"

# ===== Cuenta admin (solo la usa el seed para crear al admin) =====
ADMIN_EMAIL="admin@ti.local"
ADMIN_PASSWORD="admin1234"
ADMIN_NAME="Administrador TI"

# ===== Notificaciones Telegram =====
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ===== Notificaciones por correo =====
NOTIFY_EMAIL_TO="ti@empresa.com"
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# ===== Notificaciones por correo (Resend) =====
RESEND_API_KEY=""
RESEND_FROM=""