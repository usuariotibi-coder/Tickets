# ===== Base de datos (PostgreSQL accesible desde internet) =====
# Puedes reusar la de Railway, o crear una gratis en Neon, Supabase o Prisma Postgres.
DATABASE_URL="postgresql://user:pass@host:5432/dbname"

# ===== Autenticación =====
NEXTAUTH_SECRET="cambia-este-valor-por-un-secreto-largo"
NEXTAUTH_URL="https://asistente-ti.<TU-DOMINIO>.workers.dev"

# ===== IA (DeepSeek) =====
DEEPSEEK_API_KEY="sk-..."
DEEPSEEK_MODEL="deepseek-chat"

# ===== Cuenta admin (solo la usa el seed para crear al admin) =====
ADMIN_EMAIL="admin@ti.local"
ADMIN_PASSWORD="admin1234"
ADMIN_NAME="Administrador TI"

# ===== Notificaciones Telegram =====
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ===== Notificaciones por correo =====
NOTIFY_EMAIL_TO="ti@empresa.com"
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# ===== Notificaciones por correo (Resend) =====
RESEND_API_KEY=""
RESEND_FROM=""

# ===== Despliegue en Cloudflare Workers =====
# 1) Copia este archivo a `.env` y llena los valores.
# 2) Crea las tablas y datos iniciales en la BD:
#       npm run db:deploy
# 3) Compila y despliega (el token se lee de CLOUDFLARE_API_TOKEN):
#       npm run deploy
# 4) Sube las variables como secrets del worker:
#       powershell -File scripts/cf-secrets.ps1